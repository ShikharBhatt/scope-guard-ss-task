{
  "name": "scope-guard",
  "version": "1.0.0",
  "description": "Scope Guard: Egress control and audit proxy for untrusted AI workers",
  "author": "Scope Guard Team",
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "prisma:generate": "prisma generate",
    "start": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test,scripts}/**/*.ts\" --fix",
    "test": "jest --config jest.config.ts",
    "test:unit": "jest --config jest.config.ts --testPathPattern=src/.*\\.spec\\.ts$",
    "test:integration": "jest --config jest.config.ts --testPathPattern=.*\\.integration\\.spec\\.ts$",
    "test:e2e": "jest --config jest.config.ts --testPathPattern=.*\\.e2e\\.spec\\.ts$",
    "migrate": "ts-node src/database/run-migrations.ts",
    "seed": "ts-node src/database/seed.ts",
    "demo": "ts-node scripts/demo.ts",
    "test:docker": "ts-node scripts/test-docker.ts",
    "test:isolation": "ts-node scripts/test-tenant-isolation.ts",
    "tenant:create": "ts-node scripts/create-tenant.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
